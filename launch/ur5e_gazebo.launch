<launch>
  <!--
    Standalone Gazebo bring-up for the UR5e sim scene:
      * worlds/ur5e_scene.world (sun + ground + ur5_base + cafe_table)
      * UR5e + Robotiq 2F-85 spawned on top of ur5_base (z = 0.59)
      * optional red cube on the table
      * head-mount Kinect v2 (URDF-declared, parent="world")
      * robot_state_publisher + ros_control

    Verify:
      roslaunch ur5e_description_extras ur5e_gazebo.launch
      rostopic echo /ur5e/joint_states
      rostopic list | grep /ur5e/arm_controller

    Add MoveIt:
      roslaunch ur5e_description_extras ur5e_gazebo.launch start_moveit:=true
  -->
  <arg name="robot_name"     default="ur5e"/>
  <arg name="paused"         default="false"/>
  <arg name="gui"            default="true"/>
  <arg name="load_cube"      default="true"/>
  <arg name="start_moveit"   default="false"/>
  <arg name="use_moveit_rviz" default="false"/>

  <!-- Resolve `model://ur5_base` / `model://cafe_table` in the world
       file. Also picked up by `gazebo_ros` for any later spawn calls. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find ur5e_description_extras)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <!-- 1. World (already has ur5_base + cafe_table baked in). -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find ur5e_description_extras)/worlds/ur5e_scene.world"/>
    <arg name="gui"        value="$(arg gui)"/>
    <arg name="paused"     value="$(arg paused)"/>
  </include>

  <!-- 2. Optional red cube on the cafe_table.
       Cube edge = 4 cm, half-edge = 2 cm; spawn at z = 0.795 so it
       rests on the table top at z = 0.775. -->
  <node if="$(arg load_cube)" name="spawn_cube" pkg="gazebo_ros" type="spawn_model"
        output="screen"
        args="-file $(find ur5e_description_extras)/models/block/block.sdf -sdf
              -model red_cube -x 0.4 -y -0.2 -z 0.795"/>

  <!-- 3. UR5e + Robotiq + Kinect URDF under /ur5e.
       Spawn at z = 0.59 so the arm sits on top of the ur5_base top plate. -->
  <group ns="$(arg robot_name)">
    <param name="robot_description"
           command="$(find xacro)/xacro --inorder
                    '$(find ur5e_description_extras)/urdf/ur5e_robotiq85_kinect.urdf.xacro'"/>

    <!--
      Initial joint pose. UR5e zeros = arm horizontal at base height (z=0.59),
      which intersects the cafe-table column at x=0.7. The pose below folds
      the arm upright with the EE over the workspace area, well clear of the
      table:
        shoulder_pan  =  0       (centred, facing +x)
        shoulder_lift = -pi/2    (upper arm vertical, pointing up)
        elbow         =  pi/2    (forearm forward at the top)
        wrist_1       = -pi/2    (wrist pointing down)
        wrist_2       = -pi/2    (gripper facing +x)
        wrist_3       =  0
    -->
    <node name="ur5e_spawn" pkg="gazebo_ros" type="spawn_model"
          respawn="false" output="screen"
          args="-urdf -param /$(arg robot_name)/robot_description
                -robot_namespace /$(arg robot_name)
                -model $(arg robot_name)
                -z 0.59
                -J shoulder_pan_joint  0
                -J shoulder_lift_joint -1.5707
                -J elbow_joint          1.5707
                -J wrist_1_joint       -1.5707
                -J wrist_2_joint       -1.5707
                -J wrist_3_joint        0"/>

    <node name="robot_state_publisher" pkg="robot_state_publisher"
          type="robot_state_publisher" output="screen"/>

    <include file="$(find ur5e_description_extras)/launch/ur5e_control.launch"/>
  </group>

  <!-- 4. Optional MoveIt via the existing ur5e_robotiq_85_moveit_config. -->
  <include if="$(arg start_moveit)"
           file="$(find ur5e_robotiq_85_moveit_config)/launch/move_group.launch">
    <arg name="publish_monitored_planning_scene" value="true"/>
    <arg name="fake_execution_type"              value="false"/>
    <arg name="moveit_controller_manager"        value="simple"/>
  </include>

  <node if="$(arg use_moveit_rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find ur5e_robotiq_85_moveit_config)/launch/moveit.rviz"/>
</launch>
