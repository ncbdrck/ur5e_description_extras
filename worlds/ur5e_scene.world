<?xml version="1.0" ?>
<!--
  UR5e sim scene. Pre-populates the world with the ur5_base
  (4-legged 0.59 m platform) and a cafe_table at (0.7, 0, 0).
  The arm and cube are spawned by ur5e_gazebo.launch so the RL env's
  reset path can re-spawn the cube without rebuilding the world.

  Model URIs resolve via the GAZEBO_MODEL_PATH env tag in
  ur5e_gazebo.launch (which points at ur5e_description_extras/models).
-->
<sdf version="1.6">
  <world name="ur5e_scene">

    <gui>
      <camera name="user_camera">
        <pose>1.4 -2.3 1.4 0.0 0.25 1.9</pose>
      </camera>
    </gui>

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- The robot base. Top plate at z = 0.59 -->
    <include>
      <uri>model://ur5_base</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Workspace table. Top at z = 0.775 -->
    <include>
      <uri>model://cafe_table</uri>
      <pose>0.7 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
